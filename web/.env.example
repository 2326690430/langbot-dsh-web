# Leave empty in development to use Vite's same-origin proxy. This keeps API,
# login, and WebSocket requests working when the UI is opened from another
# device on the local network.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:5300

# Sentry error monitoring. Leave all three empty to keep monitoring off in dev.
# Set VITE_SENTRY_DSN to your Sentry project's DSN to enable error + source-map reporting.
VITE_SENTRY_DSN=
VITE_SENTRY_ORG=
VITE_SENTRY_PROJECT=
